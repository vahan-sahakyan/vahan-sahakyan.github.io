---
import Icon from "./Icon.astro";
import { person, contact, socials } from "../data/profile";

// chips ride the stream at these points along it; side pushes them off the band's center line
const chips = [
  { label: "gateway", group: "edge", t: 0.14, side: -1 },
  { label: "posts", group: "service", t: 0.3, side: 1 },
  { label: "redpanda", group: "stream", t: 0.47, side: -1 },
  { label: "feed", group: "service", t: 0.63, side: 1 },
  { label: "search", group: "service", t: 0.78, side: -1 },
  { label: "clickhouse", group: "store", t: 0.92, side: 1 },
];
const shippedFor = ["Forbes", "Warner Music Group", "Optimum Partners", "Datafoundry"];
---

<section class="hero dark" id="top" data-hero>
  <div class="hero-stream" data-stream aria-hidden="true">
    <canvas></canvas>
    {
      chips.map((c, i) => (
        <span class={`hero-chip g-${c.group}`} data-t={c.t} data-side={c.side} style={`--i:${i}`}>
          <svg class="hero-chip-cursor" viewBox="0 0 12 12">
            <path d="M1 1l9 4-4 1.2L4.8 10z" />
          </svg>
          <i class="dot" />
          {c.label}
        </span>
      ))
    }
  </div>

  <div class="wrap hero-inner">
    <a class="hero-now" href="#experience">
      <b>Now</b>
      <span>Building Forbes Vetted backends</span>
      <Icon name="arrow-ne" />
    </a>

    <div class="hero-grid">
      <h1 class="display hero-title">
        <span class="hl"><span>{person.name}</span></span>
        <span class="hl tone"><span>{person.role}</span></span>
      </h1>
      <p class="hero-tagline body-lg">
        5+ years designing distributed systems end to end, from the data model and APIs to event streaming and the
        Kubernetes clusters they run on.
      </p>
    </div>

    <div class="hero-actions">
      <span data-magnetic>
        <a class="btn btn-primary" href={`mailto:${contact.email}`}><Icon name="mail" /> Email me</a>
      </span>
      <span data-magnetic>
        <a class="btn" href={contact.telegram.href} target="_blank" rel="noopener"><Icon name="telegram" /> Telegram</a>
      </span>
      <span data-magnetic>
        <a class="btn" href={person.cv} target="_blank" rel="noopener">
          Resume <Icon name="arrow-ne" /><span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </span>
      <ul class="hero-social" aria-label="Social profiles">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                <Icon name={s.icon} />
                <span class="visually-hidden">{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="hero-motto mono"><span aria-hidden="true">// </span>backends you stop worrying about</p>

    <div class="hero-shipped">
      <p class="mono">Shipped for</p>
      <ul>
        {shippedFor.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    /* motion.ts flattens these as the next section comes up */
    --hero-r: clamp(20px, 3vw, 36px);
    border-radius: 0 0 var(--hero-r) var(--hero-r);
  }
  .hero-stream {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-stream canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-xl) var(--ease-soft);
  }
  .hero-stream.is-ready canvas {
    opacity: 1;
  }
  /* service chips floating on the stream, placed by hero-stream.ts */
  .hero-chip {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 9px;
    border: 1px solid var(--dk-line);
    border-radius: var(--radius-xs);
    background: rgba(20, 20, 20, 0.82);
    color: var(--dk-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transition:
      color var(--dur-md),
      border-color var(--dur-md),
      opacity var(--dur-lg);
  }
  .hero-stream.is-ready .hero-chip {
    opacity: 1;
  }
  .hero-chip.is-hot {
    color: var(--dk-ink);
    border-color: var(--c);
  }
  .hero-chip-cursor {
    position: absolute;
    top: -9px;
    left: -9px;
    width: 12px;
    height: 12px;
    fill: var(--dk-muted);
  }
  .hero-chip .dot {
    width: 6px;
    height: 6px;
  }
  .g-edge {
    --c: var(--c-edge);
  }
  .g-service {
    --c: var(--c-service);
  }
  .g-stream {
    --c: var(--c-stream);
  }
  .g-store {
    --c: var(--c-store);
  }
  .g-infra {
    --c: var(--c-infra);
  }
  .g-dlq {
    --c: var(--c-dlq);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-chip {
      animation: chip-float 6s var(--ease-inOut) infinite alternate;
      animation-delay: calc(var(--i) * -1.1s);
    }
  }
  @keyframes chip-float {
    to {
      translate: 0 -8px;
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    min-height: min(100svh, 920px);
    padding-top: calc(var(--nav-h) + clamp(56px, 11vh, 132px));
  }
  /* status chip, like a release badge */
  .hero-now {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 5px 10px 5px 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xs);
    color: var(--ink);
    font-size: 0.8125rem;
    transition: border-color var(--dur-sm);
  }
  .hero-now:hover {
    border-color: var(--ink-2);
  }
  .hero-now b {
    padding: 1px 6px;
    border-radius: 2px;
    background: rgba(255, 138, 92, 0.16);
    color: #ff8a5c;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero-now svg {
    width: 12px;
    height: 12px;
    color: var(--muted);
  }

  .hero-grid {
    display: grid;
    gap: 24px;
    max-width: 1000px;
    margin-top: 24px;
  }
  .hero-title .hl {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero-title .hl > span {
    display: block;
  }
  .hero-tagline {
    max-width: 540px;
    color: var(--ink-2);
  }
  /* the slogan, kept quiet: a code comment under the actions */
  .hero-motto {
    margin-top: 28px;
    color: var(--muted);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }
  .hero-motto span {
    opacity: 0.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: clamp(28px, 5vh, 48px);
  }
  .hero-social {
    display: flex;
    gap: 2px;
    margin-left: 8px;
  }
  .hero-social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-xs);
    color: var(--muted);
    transition: color var(--dur-sm);
  }
  .hero-social a:hover {
    color: var(--ink);
  }
  .hero-social svg {
    width: 17px;
    height: 17px;
  }

  .hero-shipped {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 48px;
    margin-top: auto;
    padding-block: clamp(48px, 9vh, 96px) clamp(36px, 6vh, 56px);
  }
  .hero-shipped p {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero-shipped ul {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 40px;
  }
  .hero-shipped li {
    color: var(--ink);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    opacity: 0.85;
  }

  /* intro: pure css so the headline never waits on js */
  @media (prefers-reduced-motion: no-preference) {
    .hero-now,
    .hero-tagline,
    .hero-actions,
    .hero-motto,
    .hero-shipped {
      animation: hero-rise var(--dur-lg) var(--ease-out) both;
    }
    .hero-title .hl > span {
      animation: hero-line var(--dur-lg) var(--ease-out) both;
    }
    .hero-title .hl:nth-child(1) > span {
      animation-delay: 0.08s;
    }
    .hero-title .hl:nth-child(2) > span {
      animation-delay: calc(0.08s + var(--stagger-line));
    }
    .hero-tagline {
      animation-delay: 0.3s;
    }
    .hero-actions {
      animation-delay: 0.4s;
    }
    .hero-motto {
      animation-delay: 0.5s;
    }
    .hero-shipped {
      animation-delay: 0.6s;
    }
  }
  .hero-shipped {
    position: relative;
  }
  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-y));
    }
  }

  @media (max-width: 640px) {
    .hero-inner {
      min-height: 0;
      padding-top: calc(var(--nav-h) + 40vw);
    }
    .hero-social {
      margin-left: 0;
    }
    .hero-shipped {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-top: 48px;
    }
    .hero-shipped ul {
      justify-content: flex-start;
      gap: 10px 24px;
    }
  }
</style>
