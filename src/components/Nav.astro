---
import Icon from "./Icon.astro";
import { nav, person } from "../data/profile";
---

<header class="nav" data-nav>
  <div class="wrap">
    <div class="nav-bar">
      <a href="#top" class="nav-id" data-nav-id>
        <img src={person.photo} width="240" height="240" alt="" />
        <span class="nav-id-name">{person.name}</span>
      </a>

      <nav class="nav-primary" aria-label="Primary">
        <ul class="nav-links">
          {
            nav.map((l) => (
              <li>
                <a class="nav-link ulink" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="nav-actions">
        <a class="btn btn-sm nav-cv" href={person.cv} target="_blank" rel="noopener">
          Resume <Icon name="arrow-ne" /><span class="visually-hidden">(opens in a new tab)</span>
        </a>
        <a class="btn btn-primary btn-sm" href="#contact">Let's talk</a>
      </div>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>
        <span class="nav-toggle-bars" aria-hidden="true"></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>

    <div class="nav-sheet" id="nav-sheet" data-nav-sheet hidden>
      <ul>
        {
          nav.map((l, i) => (
            <li>
              <a href={l.href}>
                <span class="mono">0{i + 2}</span>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={person.cv} target="_blank" rel="noopener">
            <span class="mono">CV</span>Resume <Icon name="arrow-ne" />
          </a>
        </li>
        <li><a class="btn btn-primary" href="#contact">Let's talk</a></li>
      </ul>
    </div>
  </div>
</header>

<style is:global>
  .nav {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 50;
  }
  .nav-bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 52px;
    padding: 0 8px 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-2) 86%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    transition:
      background-color var(--dur-md) var(--ease-out),
      border-color var(--dur-md) var(--ease-out);
  }
  /* over dark sections the bar goes dark with them */
  .nav.on-dark .nav-bar {
    --ink: var(--dk-ink);
    --ink-2: var(--dk-ink-2);
    --muted: var(--dk-muted);
    --line: var(--dk-line);
    --line-strong: var(--dk-line-strong);
    --accent: #6f7dff;
    --accent-hover: #8e99ff;
    --on-accent: #0c0c0c;
    background: rgba(22, 22, 22, 0.82);
  }

  .nav-id {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity var(--dur-md) var(--ease-out),
      transform var(--dur-md) var(--ease-out);
  }
  .nav-id.is-visible,
  .nav.is-open .nav-id {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .nav-id img {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-xs);
    object-fit: cover;
  }
  .nav-id-name {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
  }

  .nav-links {
    display: flex;
    gap: 26px;
  }
  .nav-link {
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-cv svg {
    width: 13px;
    height: 13px;
  }

  .nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-xs);
  }
  .nav-toggle-bars,
  .nav-toggle-bars::before {
    display: block;
    width: 18px;
    height: 1.5px;
    margin: auto;
    background: var(--ink);
    transition: transform var(--dur-sm) var(--ease-out);
  }
  .nav-toggle-bars {
    position: relative;
    transform: translateY(-3px);
  }
  .nav-toggle-bars::before {
    content: "";
    position: absolute;
    top: 6px;
  }
  .nav.is-open .nav-toggle-bars {
    transform: translateY(0) rotate(45deg);
  }
  .nav.is-open .nav-toggle-bars::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  .nav-sheet {
    margin-top: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    box-shadow: var(--shadow-lift);
  }
  .nav-sheet ul {
    display: grid;
    padding: 8px 18px 20px;
  }
  .nav-sheet a:not(.btn) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .nav-sheet a svg {
    width: 15px;
    height: 15px;
    align-self: center;
  }
  .nav-sheet .mono {
    min-width: 2.2em;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .nav-sheet .btn {
    justify-content: center;
    margin-top: 16px;
  }

  @media (max-width: 960px) {
    .nav-primary,
    .nav-actions {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
  }
  @media (min-width: 961px) {
    .nav-sheet {
      display: none;
    }
  }
</style>
