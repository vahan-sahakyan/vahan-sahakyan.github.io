---
import Icon from "./Icon.astro";
import { person, contact, socials, nav } from "../data/profile";

// the full name as the wordmark; each letter gets its own vertical gradient, cycling through the palette
const fills = [
  ["#efe8dc", "#f2b9a0"],
  ["#efe8dc", "#ff8a5c"],
  ["#c3ccff", "#3446f0"],
  ["#3446f0", "#8e99ff"],
  ["#efe8dc", "#f6d4bb"],
  ["#ff8a5c", "#3446f0"],
  ["#a9b6ff", "#efe8dc"],
  ["#f6d4bb", "#ff6a3d"],
];
const word = person.name.toLowerCase().split("");
---

<footer class="footer dark" data-nav-dark>
  <p class="footer-word" aria-hidden="true">
    {word.map((ch, i) => (ch === " " ? <span class="footer-gap" /> : <span style={`--a:${fills[i % fills.length][0]};--b:${fills[i % fills.length][1]}`}>{ch}</span>))}
  </p>

  <div class="wrap footer-cols">
    <nav aria-label="Sections">
      <p>Sections</p>
      <ul>
        {
          nav.map((l) => (
            <li>
              <a class="ulink" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p>Contact</p>
      <ul>
        <li><a class="ulink" href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a class="ulink" href={contact.phone.href}>{contact.phone.label}</a></li>
        <li><a class="ulink" href={contact.telegram.href} target="_blank" rel="noopener">{contact.telegram.label}</a></li>
      </ul>
    </div>
    <div>
      <p>Social</p>
      <ul>
        {
          socials.map((s) => (
            <li>
              <a class="ulink" href={s.href} target="_blank" rel="noopener">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p>Resume</p>
      <ul>
        <li>
          <a class="ulink" href={person.cv} target="_blank" rel="noopener">Print-ready CV</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bar">
    <p class="mono">&copy; <span data-year>2026</span> {person.name}</p>
    <a class="act footer-top" href="#top">Back to top <Icon name="arrow-up" /></a>
  </div>
</footer>

<style is:global>
  .footer {
    margin-top: clamp(8px, 1.2vw, 16px);
    border-radius: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px) 0 0;
    overflow: hidden;
  }
  .footer-word {
    display: flex;
    justify-content: center;
    /* em, so the crop line sits at the same point of the letters at every width */
    height: calc(0.74em + clamp(24px, 3.4vw, 48px));
    overflow: hidden;
    padding-top: clamp(24px, 3.4vw, 48px);
    font-size: clamp(2.6rem, 0.4rem + 10.6vw, 10.5rem);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.06em;
    user-select: none;
  }
  .footer-word span {
    background: linear-gradient(180deg, var(--a), var(--b));
    background-size: 100% 160%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-position var(--dur-xl) var(--ease-out);
  }
  .footer-word .footer-gap {
    width: 0.28em;
  }
  .footer-word:hover span {
    background-position: 0 100%;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    padding-block: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }
  .footer-cols p {
    margin-bottom: 14px;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .footer-cols ul {
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
  }
  .footer-cols a {
    color: var(--ink-2);
  }
  .footer-cols a:hover {
    color: var(--ink);
  }
  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px 28px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
