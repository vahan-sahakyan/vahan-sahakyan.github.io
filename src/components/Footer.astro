---
import Icon from "./Icon.astro";
import { person, contact, socials, nav } from "../data/profile";

// the closing call to action, set as a wordmark. no descenders, so the bottom crop reads cleanly
const word = "work with me";
---

<footer class="footer dark">
  <a class="footer-word" href={`mailto:${contact.email}`} aria-label={`Work with me: email ${contact.email}`}>
    <span>{word}</span>
  </a>

  <!-- the lighter panel's top edge is the line the wordmark rises from -->
  <div class="footer-panel">
  <div class="wrap footer-cta">
    <p>Hiring for backend, platform or distributed systems? I'd like to hear about it.</p>
    <a class="act" href={`mailto:${contact.email}`}>{contact.email} <Icon name="arrow-ne" /></a>
  </div>

  <div class="wrap footer-cols">
    <nav aria-label="Sections">
      <p>Sections</p>
      <ul>
        {
          nav.map((l) => (
            <li>
              <a class="ulink" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p>Contact</p>
      <ul>
        <li><a class="ulink" href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a class="ulink" href={contact.phone.href}>{contact.phone.label}</a></li>
        <li><a class="ulink" href={contact.telegram.href} target="_blank" rel="noopener">{contact.telegram.label}</a></li>
      </ul>
    </div>
    <div>
      <p>Social</p>
      <ul>
        {
          socials.map((s) => (
            <li>
              <a class="ulink" href={s.href} target="_blank" rel="noopener">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p>Resume</p>
      <ul>
        <li>
          <a class="ulink" href={person.cv} target="_blank" rel="noopener">Print-ready CV</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bar">
    <p class="mono">&copy; <span data-year>2026</span> {person.name}</p>
    <a class="act footer-top" href="#top">Back to top <Icon name="arrow-up" /></a>
  </div>
  </div>
</footer>

<style is:global>
  .footer {
    position: relative;
    overflow: hidden;
  }
  .footer-panel {
    background: var(--dk-surface);
  }
  .footer-word {
    display: flex;
    justify-content: center;
    /* em, so the crop line sits at the same point of the letters at every width */
    height: calc(0.74em + clamp(24px, 3.4vw, 48px));
    overflow: hidden;
    padding-top: clamp(24px, 3.4vw, 48px);
    /* spans nearly the full width, like docker's wordmark */
    font-size: 12.4vw;
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }
  /* one gradient across the whole phrase: blue to cream to coral, routed through cream so it never turns purple.
     motion.ts raises it from behind the panel and drifts the gradient as it rises */
  .footer-word span {
    display: inline-block;
    background: linear-gradient(90deg, #5b6cff 0%, #a9b6ff 20%, #efe8dc 46%, #f6d4bb 64%, #ff7a48 86%, #ff6a3d 100%);
    background-size: 160% 100%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .footer-word:focus-visible {
    outline-offset: -6px;
  }
  .footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 1rem;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    padding-block: clamp(40px, 5vw, 64px);
  }
  .footer-cols p {
    margin-bottom: 14px;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .footer-cols ul {
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
  }
  .footer-cols a {
    color: var(--ink-2);
  }
  .footer-cols a:hover {
    color: var(--ink);
  }
  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px 28px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
