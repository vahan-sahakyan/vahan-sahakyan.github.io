---
import SectionHead from "./SectionHead.astro";
import CaseStudy from "./CaseStudy.astro";
import Icon from "./Icon.astro";
import { caseStudies } from "../data/projects";
---

<section class="section band work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead index="03" label="Work" title="Case studies," tone="drawn as the systems they are." id="work-title">
      <p>
        Problem, architecture, result. Each diagram is the real service topology: filter by edge type, trace a node's
        dependencies, zoom in.
      </p>
    </SectionHead>

    {caseStudies.map((s) => <CaseStudy study={s} />)}

    <p class="work-more" data-reveal>
      <a class="act" href="https://github.com/vahan-sahakyan?tab=repositories" target="_blank" rel="noopener">
        More on GitHub <Icon name="arrow" />
      </a>
    </p>
  </div>
</section>

<style is:global>
  .work-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(56px, 7vw, 96px);
  }
</style>
