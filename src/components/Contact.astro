---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import dusk from "../assets/art/dusk.png";
import { contact, socials, person } from "../data/profile";

const rows = [
  { label: "Say hi", value: contact.email, href: `mailto:${contact.email}`, icon: "mail" as const },
  { label: "Call me", value: contact.phone.label, href: contact.phone.href, icon: "phone" as const },
  { label: "Message me", value: contact.telegram.label, href: contact.telegram.href, icon: "telegram" as const, external: true },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="contact-art" aria-hidden="true">
    <div data-parallax="mid">
      <Picture src={dusk} formats={["avif", "webp"]} fallbackFormat="webp" widths={[480, 900]} sizes="(max-width: 820px) 90vw, 46vw" alt="" loading="lazy" />
    </div>
  </div>

  <div class="wrap">
    <p class="eyebrow" data-reveal><b>05</b> / Contact</p>
    <h2 class="display contact-title" id="contact-title" data-split>Let's build <span class="gradient-text">together.</span></h2>

    <div class="contact-grid">
      <div class="contact-main">
        <p class="body-lg contact-lede" data-reveal>
          Open to new opportunities and technical collaboration in backend and distributed systems.
        </p>

        <ul class="contact-rows">
          {
            rows.map((r) => (
              <li data-reveal>
                <a class="contact-row" href={r.href} target={r.external ? "_blank" : undefined} rel={r.external ? "noopener" : undefined}>
                  <span class="contact-row-label mono">
                    <Icon name={r.icon} />
                    {r.label}
                  </span>
                  <span class="contact-row-value">{r.value}</span>
                  <Icon name="arrow-ne" class="contact-row-arrow" />
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="contact-social" aria-label="Social profiles" data-reveal>
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  <Icon name={s.icon} />
                  <span class="visually-hidden">{s.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a class="cv card" href={person.cv} target="_blank" rel="noopener" data-tilt data-reveal>
        <span class="card-glow" aria-hidden="true"></span>
        <span class="cv-paper" aria-hidden="true">
          <span class="cv-paper-head">
            <span class="cv-paper-photo"></span>
            <span>
              <span class="cv-bar w60 ink"></span>
              <span class="cv-bar w40"></span>
            </span>
          </span>
          <span class="cv-bar w90"></span>
          <span class="cv-bar w80"></span>
          <span class="cv-bar w85"></span>
          <span class="cv-rule"></span>
          <span class="cv-bar w50 ink"></span>
          <span class="cv-bar w90"></span>
          <span class="cv-bar w75"></span>
          <span class="cv-bar w80"></span>
          <span class="cv-rule"></span>
          <span class="cv-bar w45 ink"></span>
          <span class="cv-bar w70"></span>
          <span class="cv-bar w60"></span>
        </span>
        <span class="cv-info">
          <span class="chip">A4 · Print-ready PDF</span>
          <span class="cv-title">Resume</span>
          <span class="cv-sub">One page, kept current. Open it or save it as a PDF.</span>
          <span class="cv-cta">Open CV <Icon name="arrow-ne" /></span>
        </span>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .contact {
    overflow: clip;
    isolation: isolate;
    padding-bottom: clamp(72px, 9vw, 128px);
  }
  .contact::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(50% 50% at 90% 30%, color-mix(in srgb, var(--g-coral) 12%, transparent), transparent 70%),
      radial-gradient(40% 40% at 70% 90%, color-mix(in srgb, var(--g-violet) 10%, transparent), transparent 70%);
  }
  .contact-art {
    position: absolute;
    z-index: -1;
    top: 2%;
    right: -8vw;
    width: min(48vw, 720px);
    aspect-ratio: 1;
    pointer-events: none;
  }
  .contact-art img {
    width: 100%;
    height: auto;
  }
  .contact-title {
    margin-top: 22px;
    max-width: 11ch;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .contact-lede {
    max-width: 520px;
  }
  .contact-rows {
    margin-top: 32px;
    border-top: 1px solid var(--line-strong);
  }
  .contact-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line-strong);
    transition: padding var(--dur-md) var(--ease-out);
  }
  .contact-row-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-row-label svg {
    width: 15px;
    height: 15px;
  }
  .contact-row-value {
    color: var(--ink);
    font-size: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .contact-row-arrow {
    width: 20px;
    height: 20px;
    color: var(--muted);
    transition:
      transform var(--dur-md) var(--ease-out),
      color var(--dur-md);
  }
  .contact-row:hover {
    padding-inline: 12px 0;
  }
  .contact-row:hover .contact-row-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }
  .contact-social {
    display: flex;
    gap: 4px;
    margin-top: 24px;
  }
  .contact-social a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface-glass);
    color: var(--ink-2);
    transition:
      color var(--dur-sm),
      border-color var(--dur-sm);
  }
  .contact-social a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .contact-social svg {
    width: 18px;
    height: 18px;
  }

  /* ---------- cv card: a paper preview of the a4 cv ---------- */
  .cv {
    display: grid;
    gap: 24px;
    padding: 22px;
    background: var(--surface-glass);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
  }
  .cv-paper {
    display: grid;
    gap: 8px;
    aspect-ratio: 210 / 150;
    padding: 18px 20px;
    overflow: hidden;
    border-radius: 10px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(10, 18, 48, 0.08),
      0 18px 36px -18px rgba(10, 18, 48, 0.35);
    transform: rotate(-2deg) translateY(4px);
    transition: transform var(--dur-md) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .cv:hover .cv-paper {
    transform: rotate(0deg) translateY(-2px);
  }
  .cv-paper-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .cv-paper-head > span:last-child {
    display: grid;
    flex: 1;
    gap: 6px;
  }
  .cv-paper-photo {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--g-blue), var(--g-magenta));
  }
  .cv-bar {
    display: block;
    height: 5px;
    border-radius: 3px;
    background: #e3e6ef;
  }
  .cv-bar.ink {
    height: 7px;
    background: #1b2240;
  }
  .cv-rule {
    height: 1px;
    margin-block: 4px;
    background: #e3e6ef;
  }
  .w40 {
    width: 40%;
  }
  .w45 {
    width: 45%;
  }
  .w50 {
    width: 50%;
  }
  .w60 {
    width: 60%;
  }
  .w70 {
    width: 70%;
  }
  .w75 {
    width: 75%;
  }
  .w80 {
    width: 80%;
  }
  .w85 {
    width: 85%;
  }
  .w90 {
    width: 90%;
  }
  .cv-info {
    display: grid;
    justify-items: start;
    gap: 8px;
  }
  .cv-title {
    margin-top: 6px;
    color: var(--ink);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .cv-sub {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .cv-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--accent);
    font-weight: 500;
  }
  .cv-cta svg {
    width: 14px;
    height: 14px;
    transition: transform var(--dur-sm) var(--ease-out);
  }
  .cv:hover .cv-cta svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cv {
      max-width: 440px;
    }
    .contact-art {
      top: -14vw;
      right: -42vw;
      width: 80vw;
      opacity: 0.55;
    }
  }
  @media (max-width: 560px) {
    .contact-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
    }
    .contact-row-label {
      grid-column: 1 / -1;
    }
  }
</style>
