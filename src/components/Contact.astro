---
import Icon from "./Icon.astro";
import { contact, person } from "../data/profile";

const rows = [
  { label: "Say hi", value: contact.email, href: `mailto:${contact.email}`, icon: "mail" as const },
  { label: "Call me", value: contact.phone.label, href: contact.phone.href, icon: "phone" as const },
  { label: "Message me", value: contact.telegram.label, href: contact.telegram.href, icon: "telegram" as const, external: true },
];
---

<section class="section band lands contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact-top">
      <div>
        <p class="tag" data-reveal><b>06</b> Contact</p>
        <h2 class="display contact-title" id="contact-title" data-split>
          Let's build <span class="tone">together.</span>
        </h2>
      </div>
      <div class="contact-cta" data-reveal>
        <p class="body-lg">Open to new opportunities and technical collaboration in backend and distributed systems.</p>
        <div class="contact-btns">
          <span data-magnetic><a class="btn btn-primary" href={`mailto:${contact.email}`}>Email me</a></span>
          <span data-magnetic>
            <a class="btn" href={contact.telegram.href} target="_blank" rel="noopener">Telegram</a>
          </span>
        </div>
      </div>
    </div>

    <div class="contact-grid">
      <ul class="cells contact-rows">
        {
          rows.map((r) => (
            <li data-reveal>
              <a class="contact-row" href={r.href} target={r.external ? "_blank" : undefined} rel={r.external ? "noopener" : undefined}>
                <span class="contact-row-label mono">
                  <Icon name={r.icon} />
                  {r.label}
                </span>
                <span class="contact-row-value">{r.value}</span>
                <Icon name="arrow-ne" class="contact-row-arrow" />
              </a>
            </li>
          ))
        }
      </ul>

      <a class="cv card" href={person.cv} data-tilt data-reveal>
        <span class="card-glow" aria-hidden="true"></span>
        <span class="tag">A4 · Print-ready PDF</span>
        <span class="cv-info">
          <span class="cv-title">Resume</span>
          <span class="cv-sub">One page, kept current. Open it or save it as a PDF.</span>
          <span class="act">Open CV <Icon name="arrow-ne" /></span>
        </span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .contact-top {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 32px 64px;
    align-items: end;
  }
  .contact-title {
    margin-top: 22px;
  }
  .contact-cta {
    display: grid;
    gap: 22px;
    max-width: 440px;
    justify-self: end;
  }
  .contact-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 16px;
    align-items: stretch;
    margin-top: clamp(48px, 7vw, 88px);
  }
  .contact-rows {
    align-self: start;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .contact-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 22px clamp(18px, 2.4vw, 28px);
    transition: background-color var(--dur-sm);
  }
  .contact-row:hover {
    background: var(--bg);
  }
  .contact-row-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-row-label svg {
    width: 15px;
    height: 15px;
  }
  .contact-row-value {
    color: var(--ink);
    font-size: clamp(1.1rem, 0.95rem + 0.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .contact-row-arrow {
    width: 18px;
    height: 18px;
    color: var(--muted);
    transition:
      transform var(--dur-md) var(--ease-out),
      color var(--dur-md);
  }
  .contact-row:hover .contact-row-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  /* ---------- cv card ---------- */
  .cv {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: clamp(20px, 2.4vw, 28px);
  }
  .cv-info {
    display: grid;
    justify-items: start;
    gap: 8px;
  }
  .cv .tag {
    align-self: flex-start;
  }
  .cv-title {
    margin-top: 4px;
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .cv-sub {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .cv .act {
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .contact-top,
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact-cta {
      justify-self: start;
    }
    .cv {
      max-width: 440px;
    }
  }
  @media (max-width: 560px) {
    .contact-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
    }
    .contact-row-label {
      grid-column: 1 / -1;
    }
  }
</style>
