---
// decorative: everything here is said elsewhere on the page, so it's hidden from assistive tech
const facts = [
  "11 Go services over gRPC and Redpanda",
  "Transactional outbox, no dual writes",
  "3 retries with backoff, then DLQ",
  "100% coverage kept while shipping",
  "Multi-tenant Kubernetes on GCP",
  "5+ years building backends",
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-big">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <span>
            Built to scale<i>&#9679;</i>Built to scale<i>&#9679;</i>Built to scale<i>&#9679;</i>
          </span>
        ))
      }
    </div>
  </div>
  <div class="marquee-ticker">
    <div class="marquee-track marquee-track-slow">
      {
        [0, 1].map(() => (
          <span>
            {facts.map((f) => (
              <>
                {f}
                <b />
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .marquee-big {
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .marquee-track {
    display: flex;
    width: max-content;
  }
  .marquee-track > span {
    display: flex;
    align-items: center;
    flex: none;
  }
  .marquee-big span {
    color: var(--ink);
    /* heavy and large, filling the band edge to edge like docker's "run on trust" */
    font-size: clamp(3.5rem, 10.5vw, 14rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    /* line box about the caps' height, so the padding is the actual space above and below the letters */
    line-height: 0.74;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* the separator rides at cap height, like a registered mark */
  .marquee-big i {
    align-self: flex-start;
    margin-inline: 0.25em 0.45em;
    font-size: 0.22em;
    font-style: normal;
    line-height: 1;
    color: var(--ink);
  }
  .marquee-ticker {
    padding-block: 14px;
  }
  .marquee-ticker span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .marquee-ticker b {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-inline: 28px;
    background: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 60s linear infinite;
    }
    .marquee-track-slow {
      animation-duration: 80s;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
