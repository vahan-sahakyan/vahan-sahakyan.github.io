---
import SectionHead from "./SectionHead.astro";
import StackMap from "./StackMap.astro";
import Marquee from "./Marquee.astro";
import { capabilities } from "../data/capabilities";

// 32px line icons, one per area
const icons: Record<string, string> = {
  distributed: "M7 8a3 3 0 1 0 0-.01M25 8a3 3 0 1 0 0-.01M16 26a3 3 0 1 0 0-.01M10 8h12M8.5 10.6l6 12.6M23.5 10.6l-6 12.6",
  streaming: "M3 9h18M3 16h26M3 23h14M19 6l3 3-3 3M26 13l3 3-3 3M14 20l3 3-3 3",
  cloud: "M16 3l11 6.5v13L16 29 5 22.5v-13zM16 12a4 4 0 1 0 0 8 4 4 0 1 0 0-8zM16 3v9M16 20v9M5 9.5l7.5 4.5M19.5 18l7.5 4.5M27 9.5L19.5 14M12.5 18L5 22.5",
  data: "M6 8c0-2.2 4.5-4 10-4s10 1.8 10 4-4.5 4-10 4S6 10.2 6 8zM6 8v16c0 2.2 4.5 4 10 4s10-1.8 10-4V8M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4",
  languages: "M11 9l-7 7 7 7M21 9l7 7-7 7M18 5l-4 22",
  observability: "M4 4v24h24M8 21l6-7 5 4 8-10",
  leadership: "M9 4v24M9 18c0-6 14-4 14-10M23 4a3 3 0 1 0 0 .01M9 28a3 3 0 1 0 0 .01",
};
---

<section class="section blue lands caps" id="capabilities" aria-labelledby="caps-title">
  <div class="wrap">
    <SectionHead index="04" label="Capabilities" title="Grouped by" tone="the problems they solve." id="caps-title">
      <p>Seven areas, each with the tools used in production. The map below links tools used on the same project.</p>
    </SectionHead>

    <ul class="cells caps-grid">
      {
        capabilities.map((c, i) => (
          <li class:list={["cap", `cap-${c.id}`]} data-reveal>
            <span class="card-glow" aria-hidden="true" />
            <div class="cap-top">
              <svg class="cap-icon" viewBox="0 0 32 32" aria-hidden="true">
                <path d={icons[c.id]} />
              </svg>
              <span class="cap-index mono">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="cap-text">
              <h3 class="h3">{c.area}</h3>
              <p class="cap-body prose" set:html={c.body} />
            </div>
            <ul class="chips" aria-label={`${c.area} tools`}>
              {c.tools.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="caps-map" data-reveal>
      <StackMap />
    </div>
  </div>
  <Marquee />
</section>

<style is:global>
  .caps-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cap {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(22px, 2.6vw, 32px);
  }
  .cap-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
  }
  .cap-icon {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cap-index {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .cap-text {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .cap-body {
    max-width: 52ch;
    font-size: 0.9375rem;
  }
  /* leadership closes the grid as one wide row */
  .cap-leadership {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
  }
  .cap-leadership .cap-top {
    margin: 0;
    gap: 16px;
  }
  .cap-leadership .cap-index {
    order: -1;
  }
  .caps-map {
    margin-top: 16px;
  }
  /* the band closes the section; the room below it is where the next section tucks in */
  .section.blue.caps {
    padding-bottom: var(--land-overlap);
  }
  /* on blue the map drops its dark panel: a lighter blue card, drawn in white like the rest of the section */
  .blue .stackmap.dark {
    --ink: #ffffff;
    --ink-2: rgba(255, 255, 255, 0.88);
    --muted: rgba(255, 255, 255, 0.78);
    --line: rgba(255, 255, 255, 0.24);
    --line-strong: rgba(255, 255, 255, 0.5);
    --accent: #ffffff;
    --accent-hover: #e9ebff;
    --on-accent: var(--blue);
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.16) 1px, transparent 0) 0 0 / 20px 20px,
      var(--blue-2);
  }
  /* categories as clear tints that read on blue: cyan, white, coral, amber, mint, pink */
  .blue .stackmap .sm-edge {
    --sm-c: #8fe3ff;
  }
  .blue .stackmap .sm-service {
    --sm-c: #ffffff;
  }
  .blue .stackmap .sm-stream {
    --sm-c: #ff9466;
  }
  .blue .stackmap .sm-store {
    --sm-c: #ffd25e;
  }
  .blue .stackmap .sm-infra {
    --sm-c: #5cf0bd;
  }
  .blue .stackmap .sm-obs {
    --sm-c: #ff9de6;
  }
  .blue .stackmap .stackmap-link {
    stroke-opacity: 0.5;
  }
  .blue .stackmap .stackmap-link.is-off {
    stroke-opacity: 0.06;
  }
  .caps .marquee {
    margin-top: var(--section-y);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .caps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .caps-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cap-leadership {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
</style>
