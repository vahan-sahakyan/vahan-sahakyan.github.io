---
// tag, a two-tone heading (title, then a quieter line), and an optional lede on the right
type Props = { index: string; label: string; title: string; tone?: string; id?: string };
const { index, label, title, tone, id } = Astro.props;
---

<header class="section-head">
  <p class="tag" data-reveal><b>{index}</b> {label}</p>
  <h2 class="h2" id={id} data-split>
    {title}
    {tone && <span class="tone">{tone}</span>}
  </h2>
  {
    Astro.slots.has("default") && (
      <div class="body-lg section-head-lede" data-reveal>
        <slot />
      </div>
    )
  }
</header>
