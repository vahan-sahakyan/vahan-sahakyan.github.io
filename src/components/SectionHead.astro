---
type Props = { index: string; label: string; title: string; id?: string };
const { index, label, title, id } = Astro.props;
---

<header class="section-head">
  <p class="eyebrow" data-reveal><b>{index}</b> / {label}</p>
  <h2 class="h2" id={id} data-split>{title}</h2>
  {
    Astro.slots.has("default") && (
      <div class="body-lg section-head-lede" data-reveal>
        <slot />
      </div>
    )
  }
</header>

<style is:global>
  .section-head-lede {
    color: var(--ink-2);
  }
</style>
