const stroked = {
  arrow: "M3 8h10M9 4l4 4-4 4",
  "arrow-ne": "M4.5 11.5l7-7M5.5 4.5h6v6",
  "arrow-up": "M8 13V3M4 7l4-4 4 4",
  mail: "M2 4h12v8H2zM2 4l6 5 6-5",
  phone: "M5.5 2.5h-2a1 1 0 0 0-1 1C2.5 9 7 13.5 12.5 13.5a1 1 0 0 0 1-1v-2l-3-1-1.3 1.3a7 7 0 0 1-3-3L7.5 6.5l-1-3z",
