    "M23.9 3.4 20.3 20.6c-.3 1.2-1 1.5-2 .9l-5.5-4-2.6 2.5c-.3.3-.6.6-1.2.6l.4-5.6L19.6 6c.4-.4-.1-.6-.7-.2L6.3 13.8.9 12.1c-1.2-.4-1.2-1.2.2-1.7L22.5 2.2c1-.4 1.8.2 1.4 1.2z",
