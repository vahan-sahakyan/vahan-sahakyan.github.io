---

{
  filled[name] ? (
    <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={filled[name]} />
    </svg>
  ) : (
    <svg
      class:list={[cls, name]}
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={stroked[name]} />
    </svg>
  )
}
