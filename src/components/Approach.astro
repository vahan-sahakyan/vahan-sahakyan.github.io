---
import { storyNodes, storyEdges, storySteps, storyViewBox } from "../data/story";

const NODE_H = 34;
const CHAR_W = 7.8;
const ARROW = 6;
const width = (label: string) => Math.round(36 + label.length * CHAR_W);

type Layout = "wide" | "narrow";
const labelOf = (n: (typeof storyNodes)[number], l: Layout) => (l === "narrow" && n.short) || n.label;
const byId = Object.fromEntries(storyNodes.map((n) => [n.id, n]));

// cubic edge between node borders; the dominant axis decides which sides connect
function edgePath(fromId: string, toId: string, l: Layout) {
  const a = byId[fromId];
  const b = byId[toId];
  const [ax, ay] = a[l];
  const [bx, by] = b[l];
  const dx = bx - ax;
  const dy = by - ay;
  if (Math.abs(dx) >= Math.abs(dy)) {
    const s = Math.sign(dx);
    const sx = ax + (s * width(labelOf(a, l))) / 2;
    const ex = bx - s * (width(labelOf(b, l)) / 2 + ARROW);
    const mx = (sx + ex) / 2;
    return `M${sx},${ay}C${mx},${ay} ${mx},${by} ${ex},${by}`;
  }
  const s = Math.sign(dy);
  const sy = ay + (s * NODE_H) / 2;
  const ey = by - s * (NODE_H / 2 + ARROW);
  const my = (sy + ey) / 2;
  return `M${ax},${sy}C${ax},${my} ${bx},${my} ${bx},${ey}`;
}

const kinds = ["req", "event", "store", "dlq"] as const;
const layouts: Layout[] = ["wide", "narrow"];
---

<section class="section band lands approach" id="approach" aria-labelledby="approach-title" data-story>
  <div class="wrap story" data-story-pin>
    <div class="story-copy">
      <p class="tag" data-reveal><b>02</b> Approach</p>
      <h2 class="h2 story-heading" id="approach-title" data-split>
        One write, <span class="tone">end to end.</span>
      </h2>
      <p class="story-lede" data-reveal>
        One post through a system I built. Each service owns its data, and events, not shared tables, carry state
        between them.
      </p>

      <ol class="story-steps" data-story-steps>
        {
          storySteps.map((s, i) => (
            <li class="story-step" data-step={i} data-nodes={s.nodes.join(",")} data-edges={s.edges.join(",")}>
              <span class="story-bar" aria-hidden="true">
                <i />
              </span>
              <button type="button" class="story-step-btn" aria-pressed={i === 0 ? "true" : "false"}>
                <span class="story-num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="story-title">{s.title}</span>
              </button>
              <div class="story-body">
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="story-fig" data-story-fig>
      <p class="story-fig-cap mono">dsn / one post, end to end</p>
      {
        layouts.map((l) => (
          <svg
            class={`story-svg story-${l}`}
            viewBox={`0 0 ${storyViewBox[l][0]} ${storyViewBox[l][1]}`}
            role="img"
            aria-label="Diagram: client, gateway, posts service and ScyllaDB, Redpanda with a dead-letter topic, four consumers, ClickHouse event store, rebuilder and Valkey feeds"
          >
            <defs>
              {kinds.map((k) => (
                <marker id={`sa-${l}-${k}`} class={`sarrow k-${k}`} viewBox="0 0 10 10" refX="4" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0,0L10,5L0,10z" />
                </marker>
              ))}
            </defs>
            <g class="sedges">
              {storyEdges.map((e) => (
                <path class={`sedge k-${e.kind}`} data-edge={e.id} d={edgePath(e.from, e.to, l)} marker-end={`url(#sa-${l}-${e.kind})`} />
              ))}
            </g>
            <g class="spackets" data-packets />
            <g class="snodes">
              {storyNodes.map((n) => {
                const label = labelOf(n, l);
                const w = width(label);
                return (
                  <g class={`snode g-${n.group}`} data-node={n.id} transform={`translate(${n[l][0]},${n[l][1]})`}>
                    <rect x={-w / 2} y={-NODE_H / 2} width={w} height={NODE_H} rx="4" />
                    <circle cx={-w / 2 + 16} r="4" />
                    <text x={-w / 2 + 27} dy="0.35em">
                      {label}
                    </text>
                  </g>
                );
              })}
            </g>
          </svg>
        ))
      }
      <figcaption class="story-legend">
        <span><i class="k-req"></i>Request</span>
        <span><i class="k-event"></i>Event</span>
        <span><i class="k-store"></i>Data</span>
        <span><i class="k-dlq"></i>Dead letter</span>
      </figcaption>
    </figure>
  </div>
</section>

<style is:global>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .story-heading {
    font-size: clamp(1.9rem, 1.2rem + 1.8vw, 2.75rem);
  }
  .story-copy {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .story-lede {
    max-width: 440px;
    font-size: 0.975rem;
  }

  /* ---------- accordion of steps ---------- */
  .story-steps {
    width: 100%;
    margin-top: 12px;
    border-top: 1px solid var(--line-strong);
  }
  .story-step {
    position: relative;
    border-bottom: 1px solid var(--line-strong);
  }
  .story-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    overflow: hidden;
  }
  .story-bar i {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  .story-step-btn {
    display: flex;
    align-items: baseline;
    gap: 14px;
    width: 100%;
    padding: 14px 0;
    text-align: left;
  }
  .story-num {
    flex: none;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .story-title {
    color: var(--muted);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    transition: color var(--dur-md) var(--ease-out);
  }
  .story-step.is-active .story-title,
  .story-step-btn:hover .story-title {
    color: var(--ink);
  }
  .story-step.is-active .story-num {
    color: var(--accent);
  }
  /* bodies open with a grid-row transition, no height measuring */
  .story-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--dur-md) var(--ease-out);
  }
  .story-body p {
    overflow: hidden;
    padding-left: calc(0.6875rem * 2.4 + 14px);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .story.is-live .story-body {
    grid-template-rows: 0fr;
  }
  .story.is-live .story-step.is-active .story-body {
    grid-template-rows: 1fr;
  }
  .story.is-live .story-step.is-active .story-body p {
    padding-bottom: 16px;
  }

  /* ---------- visual panel, on the section's own color ---------- */
  .story-fig {
    --k-req: var(--c-edge);
    --k-event: var(--c-stream);
    --k-store: var(--c-store);
    --k-dlq: var(--c-dlq);
    position: relative;
    padding: clamp(18px, 2.4vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 1px 1px, var(--dots) 1px, transparent 0) 0 0 / 20px 20px;
  }
  .story-fig-cap {
    margin-bottom: 14px;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .story-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .story-narrow {
    display: none;
  }
  .k-req {
    --k: var(--k-req);
  }
  .k-event {
    --k: var(--k-event);
  }
  .k-store {
    --k: var(--k-store);
  }
  .k-dlq {
    --k: var(--k-dlq);
  }
  .sedge {
    fill: none;
    stroke: var(--k);
    stroke-width: 1.4;
    opacity: 0.75;
    transition:
      stroke var(--dur-md) var(--ease-out),
      opacity var(--dur-md) var(--ease-out);
  }
  .sarrow path {
    fill: var(--k);
  }
  .sedge.k-event,
  .sedge.k-dlq {
    stroke-dasharray: 5 4;
  }
  .snode {
    transition: opacity var(--dur-md) var(--ease-out);
  }
  .snode rect {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
    transition:
      stroke var(--dur-md) var(--ease-out),
      fill var(--dur-md) var(--ease-out);
  }
  .snode circle {
    fill: var(--c);
  }
  .snode text {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .story-svg .spackets circle {
    fill: var(--k);
  }
  .story.is-live .snode {
    opacity: 0.6;
  }
  .story.is-live .snode.is-on {
    opacity: 1;
  }
  .story.is-live .snode.is-on rect {
    stroke: var(--c);
    fill: color-mix(in srgb, var(--c) 10%, var(--surface));
  }
  .story.is-live .sedge {
    opacity: 0.32;
  }
  .story.is-live .sedge.is-on {
    opacity: 1;
    stroke-width: 1.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .story.is-live .sedge.is-on.k-event,
    .story.is-live .sedge.is-on.k-dlq {
      animation: story-flow 0.9s linear infinite;
    }
  }
  @keyframes story-flow {
    to {
      stroke-dashoffset: -18;
    }
  }
  .story-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .story-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .story-legend i {
    width: 14px;
    height: 2px;
    background: var(--k);
  }

  /* ---------- tablets and phones: diagram first, steps as swipeable cards ---------- */
  @media (max-width: 960px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    /* heading, then the diagram, then the steps */
    .story-copy {
      display: contents;
    }
    .story .tag {
      justify-self: start;
    }
    .story-fig {
      order: 1;
      margin-top: 8px;
    }
    .story-steps {
      order: 2;
    }
    .story-steps {
      display: flex;
      gap: 10px;
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 12px;
      border: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .story-steps::-webkit-scrollbar {
      display: none;
    }
    .story-step {
      flex: 0 0 min(84%, 400px);
      scroll-snap-align: start;
      padding: 4px 16px 0;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .story-step.is-active {
      border-color: var(--line-strong);
    }
    .story-bar {
      display: none;
    }
    .story.is-live .story-body,
    .story.is-live .story-step .story-body {
      grid-template-rows: 1fr;
    }
    .story-body p {
      padding: 0 0 16px;
    }
  }
  @media (max-width: 640px) {
    .story-wide {
      display: none;
    }
    .story-narrow {
      display: block;
    }
  }
</style>
