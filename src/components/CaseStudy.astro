---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import Topology from "./Topology.astro";
import type { CaseStudy } from "../data/projects";
import dockerPanels from "../assets/art/docker-panels.png";
import dockerBox from "../assets/art/docker-box.png";
import unsplashStreaks from "../assets/art/unsplash-streaks.jpg";
import unsplashDusk from "../assets/art/unsplash-dusk.jpg";

type Props = { study: CaseStudy };
const { study: s } = Astro.props;
const art = {
  "docker-panels": dockerPanels,
  "docker-box": dockerBox,
  "unsplash-streaks": unsplashStreaks,
  "unsplash-dusk": unsplashDusk,
}[s.art];
---

<article class="case" id={`case-${s.id}`} aria-labelledby={`case-${s.id}-title`}>
  <div class="case-head">
    <a class="case-cover art" href={s.repo} target="_blank" rel="noopener" data-tilt data-reveal tabindex="-1" aria-hidden="true">
      <div class="case-art" data-parallax-inner>
        <Picture src={art} formats={["avif", "webp"]} fallbackFormat="webp" quality={78} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 50vw" alt="" />
      </div>
      <span class="chip chip-ink case-chip">{s.index}</span>
      <Icon name="github" class="case-mark" />
      <span class="card-glow" aria-hidden="true"></span>
    </a>

    <div class="case-intro">
      <h3 class="case-title" id={`case-${s.id}-title`} data-reveal>{s.title}</h3>
      <p class="case-summary" data-reveal>{s.summary}</p>
      <ul class="chips" aria-label="Stack" data-reveal>
        {s.stack.map((t) => <li class="chip">{t}</li>)}
      </ul>
      <div class="case-links" data-reveal>
        <a class="btn btn-sm" href={s.repo} target="_blank" rel="noopener">
          <Icon name="github" /> View repo<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        {
          s.links?.map((l) => (
            <a class="act" href={l.href} target="_blank" rel="noopener">
              {l.label} <Icon name="arrow-ne" />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <dl class="cells case-pra">
    <div data-reveal>
      <dt class="mono"><span>01</span> Problem</dt>
      <dd>{s.problem}</dd>
    </div>
    <div data-reveal>
      <dt class="mono"><span>02</span> Architecture</dt>
      <dd>{s.architecture}</dd>
    </div>
    <div data-reveal>
      <dt class="mono"><span>03</span> Result</dt>
      <dd>
        <ul class="case-result">
          {s.result.map((r) => <li>{r}</li>)}
        </ul>
      </dd>
    </div>
  </dl>

  <div class="case-topo" data-reveal>
    <Topology id={s.id} title={s.graphTitle} label={s.graphLabel} eventLog={s.eventLog} />
  </div>
</article>

<style is:global>
  .case + .case {
    margin-top: clamp(88px, 11vw, 160px);
  }
  .case-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .case-cover {
    display: block;
    aspect-ratio: 2 / 1;
    border-radius: var(--radius);
  }
  .case-art {
    position: absolute;
    inset: -5% 0;
  }
  .case-art img {
    transition: transform var(--dur-xl) var(--ease-out);
  }
  .case-cover:hover .case-art img {
    transform: scale(1.03);
  }
  .case-mark {
    position: absolute;
    z-index: 1;
    right: 16px;
    bottom: 16px;
    width: 22px;
    height: 22px;
    color: rgba(255, 255, 255, 0.92);
  }
  .case-chip {
    position: absolute;
    z-index: 1;
    left: 14px;
    bottom: 14px;
  }
  .case-cover .card-glow {
    z-index: 0;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.22), transparent);
  }
  .case-cover:hover .card-glow {
    opacity: 1;
  }

  .case-intro {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .case-title {
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .case-summary {
    max-width: 540px;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 4px;
  }

  .case-pra {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block: clamp(36px, 5vw, 56px) 16px;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .case-pra > div {
    padding: clamp(20px, 2.4vw, 28px);
  }
  .case-pra dt {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .case-pra dt span {
    color: var(--accent);
  }
  .case-pra dd {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .case-result {
    display: grid;
    gap: 8px;
  }
  .case-result li {
    position: relative;
    padding-left: 16px;
  }
  .case-result li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 1px;
    background: var(--ink);
  }

  @media (max-width: 900px) {
    .case-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-pra {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
